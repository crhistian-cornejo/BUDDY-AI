{
  "manifest_version": 3,
  "name": "Buddy · Video compañero",
  "version": "0.3.0",
  "description": "YouTube junto a Buddy, videos flotantes y conexión local con tu mascota. Activa otros sitios solo cuando quieras.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icon-32.png",
    "32": "icon-32.png",
    "48": "icon-64.png",
    "128": "icon-128.png"
  },
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon-32.png",
      "32": "icon-32.png"
    },
    "default_title": "Buddy · Video compañero",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
